{
  "name": "harness-config-manager",
  "version": "0.1.0",
  "description": "Define agents, skills, commands, rules and MCP servers once; install them into Claude Code, GitHub Copilot, Reasonix, OpenCode and Pi with exact, item-level rollback.",
  "type": "module",
  "bin": {
    "hcm": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:cases": "vitest run tests/case-runner.test.ts",
    "test:case": "vitest run tests/case-runner.test.ts -t",
    "bless": "node -e \"process.env.UPDATE_BASELINES=1;require('child_process').execSync('npx vitest run tests/case-runner.test.ts',{stdio:'inherit',env:{...process.env,UPDATE_BASELINES:'1'}})\"",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "debug:case": "node --inspect-brk --import tsx tests/run-case.ts",
    "case": "tsx tests/run-case.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "tar": "^7.4.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "claude-code",
    "github-copilot",
    "reasonix",
    "opencode",
    "pi",
    "agents",
    "skills",
    "mcp",
    "cli"
  ],
  "license": "MIT"
}
