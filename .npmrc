# Turn an engine mismatch into a refused install with a readable message, rather
# than an EBADENGINE warning that scrolls past and resurfaces later as a crash
# inside a dependency (e.g. "node:util does not provide an export named
# styleText" from rolldown, which needs Node 20.19+).
#
# Nothing in the dependency tree asks for more than the root engines field, so
# this cannot fail an install that would otherwise have worked.
engine-strict=true
